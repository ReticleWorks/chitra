[Unit]
Description=Chitra shared triage daemon
After=chitra-watchd.service
Requires=chitra-watchd.service
ConditionPathExists=/etc/chitra/lanes.yaml
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Default poll interval is 2s (chitra-triaged's DEFAULT_POLL_SECONDS); 3x
# cadence gives one missed cycle of slack before systemd restarts it.
WatchdogSec=6
User=chitra
Group=chitra
ExecStart=/opt/chitra/venv/bin/python -m chitra.triaged --lanes-file /etc/chitra/lanes.yaml
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/chitra /run/chitra

[Install]
WantedBy=multi-user.target
