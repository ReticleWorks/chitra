[Unit]
Description=chitra persistent goal supervisor for instance %i
Documentation=https://github.com/ReticleWorks/chitra
After=network-online.target
ConditionPathExists=/etc/chitra/transcript-bindings.json

[Service]
Type=simple
# Replace with the user/group this service should run as. Do not run as root.
User=chitra
Group=chitra
# Each %i instance uses the state root declared for the matching lane in
# /etc/chitra/lanes.yaml. The shared dispatchd drains that same queue.
StateDirectory=chitra
StateDirectoryMode=0750
Environment=CHITRA_STATE_DIR=/var/lib/chitra/lane-%i
# StateDirectory creates the shared parent; this creates the isolated lane
# child before monitord opens its journal and queue.
ExecStartPre=/usr/bin/install -d -o chitra -g chitra -m 0750 ${CHITRA_STATE_DIR}
# Shadow mode records journals, findings, and supervision state without
# publishing answer or corrective orders. Keep it on until this instance's
# exact transcript bindings and decisions have been checked.
Environment=CHITRA_MONITORD_SHADOW_MODE=1
# Install one chitra.transcript-bindings.v1 manifest containing every lane at
# the conditioned path. Each instance writes its own state root and queues
# actions only for goals found in that root.
# Fill in the venv path where the immutable supervisor release was installed.
ExecStart=/opt/chitra/venv/bin/chitra-monitord --state-dir ${CHITRA_STATE_DIR} --dispatch-queue-dir ${CHITRA_STATE_DIR}/queue --transcript-bindings-path /etc/chitra/transcript-bindings.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
