[Unit]
Description=Chitra semantic agent-status and completion watcher
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chitra/lanes.yaml
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
# Default poll interval is 5s (CHITRA_WATCHD_INTERVAL); 3x cadence gives one
# missed cycle of slack before systemd concludes the loop is hung and restarts it.
WatchdogSec=15
User=chitra
Group=chitra
ExecStart=/opt/chitra/venv/bin/python -m chitra.watchd --lanes-file /etc/chitra/lanes.yaml
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/chitra /run/chitra

[Install]
WantedBy=multi-user.target
