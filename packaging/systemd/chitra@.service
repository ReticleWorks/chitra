[Unit]
Description=Chitra session anchor for lane %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chitra/lanes.yaml
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
User=root
ExecStart=/opt/chitra/venv/bin/chitra-lane-anchor --lanes-file /etc/chitra/lanes.yaml --lane %i start
ExecStop=/opt/chitra/venv/bin/chitra-lane-anchor --lanes-file /etc/chitra/lanes.yaml --lane %i stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
