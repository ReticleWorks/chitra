[Unit]
Description=Chitra shared dispatch daemon
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/chitra/lanes.yaml
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=chitra
Group=chitra
ExecStart=/opt/chitra/venv/bin/python -m chitra.dispatchd --lanes-file /etc/chitra/lanes.yaml --policy-config-path /etc/chitra/policy.yaml --routing-config-path /etc/chitra/routing.yaml
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/chitra /run/chitra

[Install]
WantedBy=multi-user.target
