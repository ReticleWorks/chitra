[Unit]
Description=chitra usage-export (publish this host's token-free usage to the shared fleet tree)
Documentation=https://github.com/ReticleWorks/chitra
After=network-online.target

[Service]
Type=oneshot
# Replace with the user/group this service should run as. Do not run as root.
User=chitra
Group=chitra
# systemd creates and owns this directory (mode 0750) for the unit's lifetime.
StateDirectory=chitra
# Fill in the venv, local usage-snapshot dir, shared fleet-dir, host, and policy paths.
ExecStart=/path/to/venv/bin/chitra-usage export --fleet-dir /path/to/shared/usage --dir /var/lib/chitra/usage --host HOSTNAME --codex-bin codex --policy-config /path/to/chitra-policy.yaml
